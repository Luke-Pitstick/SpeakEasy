---
// SPDX-FileCopyrightText: 2026 SpeakEasy contributors
// SPDX-License-Identifier: GPL-3.0-only
//
// Download links for the newest published release, resolved at build time. Installer names carry
// the version, so the links are matched by file suffix. If GitHub cannot be reached during the
// build, every button points at the latest release page instead.
import { LinkButton } from '@astrojs/starlight/components'
import { REPO_URL, formatBytes, getLatestRelease, type ReleaseAsset } from '../lib/site'

const release = await getLatestRelease()
const latestUrl = `${REPO_URL}/releases/latest`

interface Option {
	label: string
	suffix: string
}

// One main download per platform keeps the cards the same height. A second package format is a
// text link under the main button.
const platforms: { name: string; arch: string; main: Option; alternate?: Option }[] = [
	{ name: 'macOS', arch: 'Apple Silicon', main: { label: 'Download .dmg', suffix: '.dmg' } },
	{ name: 'Windows', arch: 'x64', main: { label: 'Download .exe', suffix: '-setup.exe' } },
	{
		name: 'Linux',
		arch: 'x64',
		main: { label: 'Download AppImage', suffix: '.AppImage' },
		alternate: { label: '.deb', suffix: '_amd64.deb' }
	}
]

function find(suffix: string): ReleaseAsset | undefined {
	return release?.assets.find((asset) => asset.name.endsWith(suffix))
}

const released = release?.publishedAt.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC'
})
---

<div class="downloads">
	<p class="release">
		{
			release ? (
				<>
					Latest release: <a href={release.url}>{release.tag}</a>, published {released}.
				</>
			) : (
				<>
					Download from the <a href={latestUrl}>latest release</a>.
				</>
			)
		}
	</p>
	<ul class="platforms">
		{
			platforms.map((platform) => {
				const main = find(platform.main.suffix)
				const alternate = platform.alternate && find(platform.alternate.suffix)
				return (
					<li class="platform">
						<p class="platform-name">
							{platform.name} <span class="arch">{platform.arch}</span>
						</p>
						<div class="option">
							<LinkButton href={main?.url ?? latestUrl}>{platform.main.label}</LinkButton>
							<p class="size">
								{main && formatBytes(main.size)}
								{platform.alternate && (
									<>
										{main && ' · '}
										<a href={alternate?.url ?? latestUrl}>{platform.alternate.label}</a>
										{alternate && ` (${formatBytes(alternate.size)})`}
									</>
								)}
							</p>
						</div>
					</li>
				)
			})
		}
	</ul>
</div>

<style>
	.downloads {
		margin-block: 1.5rem;
		container-type: inline-size;
	}
	.release {
		color: var(--sl-color-gray-3);
	}
	/* Stacked on narrow screens, side by side once three cards fit. */
	.platforms {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		padding: 0;
		list-style: none;
	}
	.platform {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 0;
		padding: 1.25rem;
		border: 1px solid var(--se-border);
		border-radius: var(--se-radius);
		background-color: var(--se-surface);
	}
	.platform p {
		margin: 0;
	}
	.platform-name {
		color: var(--se-heading);
		font-size: var(--sl-text-h4);
		font-weight: 700;
	}
	.arch {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		font-weight: 400;
	}
	@container (min-width: 38rem) {
		.platforms {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	.platform > .option {
		display: grid;
		margin: 0;
		gap: 0.375rem;
	}
	.option :global(.sl-link-button) {
		justify-content: center;
		margin: 0;
		padding-inline: 0.5rem;
		font-size: var(--sl-text-sm);
		white-space: nowrap;
	}
	.size {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		text-align: center;
	}
</style>
