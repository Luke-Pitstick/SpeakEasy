//
// Replaces Starlight's ThemeProvider. The site is designed light first, so it starts light and
// switches to dark only when the visitor chooses dark with the header toggle. Starlight's version
// follows the operating system, which put the whole site in navy for anyone with a dark desktop.
---

{/* Inlined so the theme is set before the page paints. */}
<script is:inline>
	window.StarlightThemeProvider = (() => {
		let stored = null
		try {
			stored = localStorage.getItem('starlight-theme')
		} catch {
			// Storage can be blocked; the site then stays light.
		}
		const theme = stored === 'dark' ? 'dark' : 'light'
		document.documentElement.dataset.theme = theme
		return {
			updatePickers(current = theme) {
				document.querySelectorAll('se-theme-toggle button').forEach((button) => {
					button.setAttribute('aria-pressed', String(current === 'dark'))
				})
			}
		}
	})()
</script>
